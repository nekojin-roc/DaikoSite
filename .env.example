DATABASE_URL="file:./daiko.db"
# Keep this directory alongside the database in persistent storage.
DAIKO_EVENT_IMAGE_DIR="./data/event-images"
DAIKO_REQUEST_IMAGE_DIR="./data/request-images"
# Internal address of the existing ParcelHub server; never expose its API directly.
PARCELHUB_URL="http://localhost:3001"
# Comma-separated, explicitly granted Daiko administrators.
DAIKO_ADMIN_EMAILS="owner@example.com"
HOST="127.0.0.1"
PORT="3002"
DAIKO_ALLOWED_ORIGINS="http://localhost:5174"
