FROM node:22-alpine3.24 AS build
RUN apk add --no-cache openssl
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY prisma/schema.prisma ./prisma/schema.prisma
COPY prisma/migrations/ ./prisma/migrations/
COPY tsconfig.json ./
COPY src/ ./src/
RUN npm run build && npm prune --omit=dev --ignore-scripts

# Ship Node and the app; npm, its cache, and the compiler stay in the builder.
FROM alpine:3.24
RUN apk upgrade --no-cache && apk add --no-cache libstdc++ openssl ca-certificates \
 && addgroup -g 1000 app && adduser -D -u 1000 -G app app \
 && mkdir -p /app/data && chown app:app /app/data && chmod 700 /app/data
COPY --from=build /usr/local/bin/node /usr/local/bin/node
WORKDIR /app
COPY --from=build /app/package.json ./
COPY --from=build /app/prisma ./prisma
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
USER app
ENV NODE_ENV=production HOST=0.0.0.0 PORT=3002
EXPOSE 3002
CMD ["sh", "-c", "umask 077; node node_modules/prisma/build/index.js migrate deploy && exec node dist/index.js"]
