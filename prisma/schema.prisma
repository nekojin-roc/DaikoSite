generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// A single host-owned release counter. Deployment tooling increments row 1.
model BuildCounter {
  id    Int @id
  value Int
}

model Group {
  id        String @id @default(cuid())
  name      String @unique
  members   Member[]
  offerings Offering[]
  events    Event[]
}

model Member {
  id      String @id @default(cuid())
  name    String
  groupId String
  group   Group @relation(fields: [groupId], references: [id], onDelete: Restrict)
  @@unique([groupId, name])
}

model Offering {
  id       String @id @default(cuid())
  name     String
  groupId  String
  group    Group @relation(fields: [groupId], references: [id], onDelete: Restrict)
  archived Boolean @default(false)
  @@index([groupId, archived])
}

model Event {
  id        String    @id @default(cuid())
  name      String
  groupName String
  groupId   String?
  group     Group?    @relation(fields: [groupId], references: [id], onDelete: Restrict)
  startsAt  DateTime
  imageUrl  String?
  createdAt DateTime  @default(now())
  requests  Request[]

  @@index([startsAt, id])
}

model Request {
  sequence     Int      @id @default(autoincrement())
  id           String   @unique @default(cuid())
  eventId      String
  event        Event    @relation(fields: [eventId], references: [id], onDelete: Restrict)
  type         String
  amount       Int?
  message      String
  memberName   String?
  offeringName String?
  imageFile    String?
  userId       String
  userName     String
  userEmail    String
  createdAt    DateTime @default(now())
  finishedAt   DateTime?

  @@index([eventId, createdAt, sequence])
  @@index([userId, createdAt, sequence])
}
